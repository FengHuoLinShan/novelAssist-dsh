{
  "name": "@novelcraft/dsh",
  "version": "0.0.1",
  "private": true,
  "engines": { "node": ">=24.11.0" },
  "description": "NovelCraft M4 mounting layer: Cordis service plugin adapting the 13 pure core packages to DSH rc.8 seams (llm/approval/storage-domain/jobs/credentials/client-modules)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@novelcraft/assistant": "*",
    "@novelcraft/context": "*",
    "@novelcraft/imports": "*",
    "@novelcraft/llm-step": "*",
    "@novelcraft/memory": "*",
    "@novelcraft/outline": "*",
    "@novelcraft/rag": "*",
    "@novelcraft/store": "*",
    "@novelcraft/trace": "*",
    "@novelcraft/vault": "*",
    "@novelcraft/world": "*",
    "@novelcraft/writing": "*"
  },
  "optionalDependencies": {
    "@novelcraft/rag-bge": "*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.8",
    "@deepseek-ai/dsh-jobs": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-storage-domain": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.8",
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.8",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.8",
    "@deepseek-ai/dsh-jobs": "0.1.0-rc.8",
    "@deepseek-ai/dsh-jobs-local": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-storage": "0.1.0-rc.8",
    "@deepseek-ai/dsh-storage-domain": "0.1.0-rc.8",
    "@deepseek-ai/dsh-storage-json": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.8",
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3",
    "@types/node": "^24.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.6"
  }
}
