{
  "name": "@novelcraft/dsh-client",
  "version": "0.0.1",
  "private": true,
  "engines": { "node": ">=24.11.0" },
  "description": "NovelCraft M4 client UI: author workspaces reading host state through an authenticated DSH Connection RPC channel",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsc -p tsconfig.build.json",
    "build:client": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-connection": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.4",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-connection": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.4",
    "react": "^18.2.0",
    "@novelcraft/assistant": "*",
    "@novelcraft/llm-step": "*",
    "@novelcraft/store": "*",
    "@novelcraft/vault": "*",
    "@novelcraft/world": "*",
    "@novelcraft/writing": "*",
    "@types/react": "~18.3.1",
    "tsdown": "^0.22.2",
    "lightningcss": "^1.32.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.6",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.4"
  }
}
